# Copy to .env for local runs, or set these as environment variables / secrets.
# Never commit real values.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Claude for invoice and notice reading: either an Anthropic key...
ANTHROPIC_API_KEY=
# ...or the Astropods AI Gateway (hackathon sponsor credits). Used instead when both are set.
ASTRO_GATEWAY_URL=
ASTRO_GATEWAY_API_KEY=
