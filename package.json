{
  "name": "spikeready",
  "version": "0.1.0",
  "description": "Gets small PayPal sellers ready for a sales spike: verified tracking, a release calendar for held funds, and invoice checks before a limitation review.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsx scripts/check-env.ts",
    "seed": "tsx scripts/seed-maria.ts",
    "tracking": "tsx scripts/upload-tracking.ts",
    "hold": "tsx scripts/simulate-hold.ts",
    "report": "tsx scripts/report.ts",
    "transactions": "tsx scripts/check-transactions.ts",
    "approve": "tsx scripts/approve-sandbox.ts",
    "invoices": "tsx scripts/invoices-check.ts",
    "serve": "tsx scripts/serve.ts",
    "register-webhook": "tsx scripts/register-webhook.ts",
    "record-demo": "tsx scripts/record-demo.ts",
    "eval": "tsx eval/run.ts",
    "mcp": "tsx scripts/mcp.ts",
    "proof": "tsx scripts/proof.ts",
    "test:e2e": "tsx test/e2e/run.ts",
    "dispute": "tsx scripts/simulate-dispute.ts",
    "ask": "tsx scripts/ask.ts",
    "open-dispute": "tsx scripts/open-sandbox-dispute.ts",
    "dispute-real": "tsx scripts/dispute-real.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
